# Alpaca — paper trading account (dev/prototype account, NOT the judging account)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Postgres (local docker-backed database for signal outcomes + checkpoints)
POSTGRES_DB=alpaca_agent
POSTGRES_USER=alpaca
POSTGRES_PASSWORD=alpaca
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://alpaca:alpaca@localhost:5432/alpaca_agent

# Featherless AI (optional — open-source LLM inference, $25 free credits)
FEATHERLESS_API_KEY=

# Agent config
AGENT_RUN_INTERVAL_MINUTES=15
