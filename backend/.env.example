# PostgreSQL Database Configuration
DATABASE_URL=postgresql://lablab_user:lablab_pass@localhost:5432/lablab_trading

# Alpaca Trading API (get from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# Agent Loop Scheduling
AGENT_LOOP_INTERVAL_SECONDS=300
AGENT_LOOP_ENABLED=True

# Market Data
MARKET_SYMBOLS=AAPL,TSLA,GOOGL,MSFT
MARKET_TIMEFRAME=1min
MARKET_LOOKBACK_BARS=500

# Meta-Learner
LEARNER_CHECKPOINT_VERSION=v1.0
LEARNER_SCOPE=default
